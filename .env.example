# ============================================================
# SL Prospecta — variáveis de ambiente
# Copie para .env e preencha. NUNCA faça commit do .env.
# ============================================================

# --- Geral ---
ENVIRONMENT=development            # development | production
DOMAIN=sinallink.com.br            # domínio base (subdomínios app., api., diagnostico.)
ACME_EMAIL=ti@sinallink.com.br     # e-mail para certificados HTTPS (Caddy)

# --- Imagens (usado no deploy) ---
GHCR_OWNER=seu-usuario-github      # dono do repositório no GitHub (minúsculas)
IMAGE_TAG=latest

# --- Banco de dados ---
POSTGRES_USER=slprospecta
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=slprospecta
DATABASE_URL=postgresql+psycopg://slprospecta:troque-esta-senha@postgres:5432/slprospecta

# --- Fila ---
REDIS_URL=redis://redis:6379/0

# --- Armazenamento de arquivos (MinIO, compatível S3) ---
MINIO_ROOT_USER=slprospecta
MINIO_ROOT_PASSWORD=troque-esta-senha-longa
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=artefatos

# --- Autenticação ---
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_EXPIRES_MINUTES=720

# --- Painel ---
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
MICROSITE_BASE_URL=http://localhost:3000/d
CORS_ORIGINS=http://localhost:3000

# --- IA e dados (a partir da Fase 1) ---
ANTHROPIC_API_KEY=
APOLLO_API_KEY=
MODEL_TRIAGE=claude-haiku-5-5
MODEL_ANALYSIS=claude-sonnet-5-5
MODEL_STRATEGY=claude-opus-5-5
DAILY_AI_BUDGET_BRL=50

# --- E-mail e agenda (a partir da Fase 3) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OUTREACH_MAILBOXES=
DAILY_SEND_LIMIT_PER_MAILBOX=40

# --- Voz do simulador de leitor de tela (Fase 5) ---
TTS_API_KEY=

# --- n8n (opcional) ---
N8N_ENCRYPTION_KEY=gere-com-openssl-rand-hex-32
