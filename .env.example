# ============================================================
# SL Prospecta — variáveis de ambiente
# Copie para .env e preencha. NUNCA faça commit do .env.
# ============================================================

# --- Geral ---
ENVIRONMENT=development            # development | production
DOMAIN=leadfactory.com.br            # domínio base (subdomínios app., api., diagnostico.)
ACME_EMAIL=ti@sinallink.com.br     # e-mail para certificados HTTPS (Caddy)

# --- Imagens (usado no deploy) ---
GHCR_OWNER=seu-usuario-github      # dono do repositório no GitHub (minúsculas)
IMAGE_TAG=latest

# --- Banco de dados ---
POSTGRES_USER=slprospecta
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=slprospecta
DATABASE_URL=postgresql+psycopg://slprospecta:troque-esta-senha@postgres:5432/slprospecta

# --- Fila ---
REDIS_URL=redis://redis:6379/0

# --- Armazenamento de arquivos (MinIO, compatível S3) ---
MINIO_ROOT_USER=slprospecta
MINIO_ROOT_PASSWORD=troque-esta-senha-longa
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=artefatos

# --- Autenticação ---
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_EXPIRES_MINUTES=720

# --- Painel ---
NEXT_PUBLIC_API_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000
MICROSITE_BASE_URL=http://localhost:3000/d
CORS_ORIGINS=http://localhost:3000

# --- IA e dados (a partir da Fase 1) ---
ANTHROPIC_API_KEY=
APOLLO_API_KEY=                    # chave mestra do Apollo (a busca de pessoas exige); nunca no repositório
APOLLO_DAILY_CREDIT_CAP=60         # teto diário de créditos do Apollo (Brasília); ao atingir, o Mapeador espera o dia seguinte
APOLLO_ENRICH_ORG=true             # 1 crédito por empresa: porte, UF e cidade para o score
APIFY_TOKEN=                       # caminho alternativo sem Apollo (ADR 0012): verificação de e-mail no Apify
APIFY_DAILY_BUDGET_USD=2           # teto diário do Apify em US$; ao atingir, o Mapeador espera o dia seguinte
MODEL_TRIAGE=claude-haiku-5-5
MODEL_ANALYSIS=claude-sonnet-5-5
MODEL_STRATEGY=claude-opus-5-5
USD_BRL_RATE=5.50                  # cotação usada para gravar o custo de IA em reais (acoes_agentes)
# AI_PRICES_USD_PER_MTOK={"claude-sonnet-5-5": [2.00, 10.00]}   # só se os preços mudarem
DAILY_AI_BUDGET_BRL=30              # teto diário de IA/dados (R$); ao atingir, a fila pausa jobs de IA (§13)

# --- Pesquisador (Fase 1) ---
RESEARCH_MAX_PAGES=6               # home + até 5 páginas institucionais
RESEARCH_COST_CAP_BRL=2.00         # teto de IA por empresa pesquisada
# WEB_ALLOW_PRIVATE_HOSTS=true     # só para testes locais com site em 127.0.0.1; nunca em produção

# --- Auditor técnico (Fase 1, serviço worker-audit) ---
AUDIT_MAX_JOBS=2                   # auditorias simultâneas (cada uma abre um Chromium)
AUDIT_MAX_PAGES=5                  # home + até 4 páginas-chave
AUDIT_PAGE_TIMEOUT_S=45

# --- E-mail e agenda (a partir da Fase 3) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OUTREACH_MAILBOXES=
DAILY_SEND_LIMIT_PER_MAILBOX=40

# --- Voz do simulador de leitor de tela (Fase 5) ---
TTS_API_KEY=

# --- n8n (opcional) ---
N8N_ENCRYPTION_KEY=gere-com-openssl-rand-hex-32
